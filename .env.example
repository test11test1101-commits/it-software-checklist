# Database Connection (TiDB Cloud MySQL connection string)
# Example: mysql://<username>.<tenant>:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/checklist_db?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/checklist_db"

# NextAuth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-secret-key-here"

# NextAuth URL (your production domain on Koyeb or localhost for dev)
NEXTAUTH_URL="http://localhost:3000"
